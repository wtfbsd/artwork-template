<?xml version="1.0" encoding="UTF-8"?>

<!--
  @NAME@ xsettings defaults.
  Install under ~/.config/xfce4/xfconf/xfce4-perchannel-xml/ (or seed via
  your packaging/first-boot tooling). IconThemeName is left at "hicolor" so
  the @NAME_LOWER@ icons installed into share/icons/hicolor always resolve.
-->

<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="IconThemeName" type="string" value="hicolor"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="DejaVu Sans 10"/>
  </property>
</channel>
